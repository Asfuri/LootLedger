// Centralized UI strings. Defaults are English; Rust populates every property via `i18n::apply`.

export struct MenuOption {
    id: string,
    label: string,
}

export global I18n {
    // Shared controls
    in property <string> clear: "Clear";
    in property <string> less: "Less";
    in property <string> presets: "Presets";
    in property <string> more: "More";

    // Window & navigation
    in property <string> win-minimize: "Minimize";
    in property <string> win-restore: "Restore";
    in property <string> win-maximize: "Maximize";
    in property <string> win-close: "Close";
    in property <string> nav-overview: "Overview";
    in property <string> nav-matches: "Matches";
    in property <string> nav-sessions: "Sessions";
    in property <string> nav-openings: "Openings";
    in property <string> nav-statistics: "Statistics";
    in property <string> nav-teammates: "Teammates";
    in property <string> nav-settings: "Settings";
    in property <string> sub-matches: "Matches read from your replays. Select one to see its breakdown and timeline.";
    in property <string> sub-sessions: "Every play session: a run of matches less than 30 minutes apart. Select one to see its matches.";
    in property <string> sub-openings: "Every chest you opened, newest first. Corrections are recorded and never silently lost.";
    in property <string> sub-teammates: "Everyone who played with you, merged across matches. Pick someone to see their profile.";
    in property <string> sub-settings: "Changes apply immediately. Your replays and ledger never leave this PC.";

    // Overview & toolbar actions
    in property <string> add-widget: "Add widget";
    in property <string> reset-layout: "Reset layout";
    in property <string> tip-customize: "Customize the dashboard";
    in property <string> tip-scan: "Check for new replays now";
    in property <string> tip-share: "Share a summary image (saved or copied, never uploaded)";
    in property <string> tip-overlay: "Pop-out counter";
    in property <string> tip-undo-opening: "Undo the last counted opening";
    in property <string> tip-export-openings: "Export the openings shown";
    in property <string> label-add-chest: "Add a manual chest";
    in property <string> palette-placeholder: "Type a page, match, teammate or setting";
    in property <string> palette-label: "Command search";
    in property <string> btn-later: "Later";
    in property <string> btn-ok: "OK";
    in property <[MenuOption]> share-options: [
        { id: "Copy summary image", label: "Copy summary image" },
        { id: "Save summary image…", label: "Save summary image…" },
        { id: "Copy weekly recap", label: "Copy weekly recap" },
        { id: "Save weekly recap…", label: "Save weekly recap…" },
    ];

    // Charts & dashboard cards
    in property <string> heat-label: "Chests by weekday and hour";
    in property <[string]> heat-days: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    in property <string> heat-fewer: "Fewer";
    in property <string> heat-more: "More";
    in property <[string]> trend-ranges: ["7d", "30d", "90d", "All"];
    in property <[string]> trend-grains: ["Day", "Week", "Month"];
    in property <[string]> chart-styles: ["Bar", "Line", "Smooth", "Area"];
    in property <string> label-date-range: "Date range";
    in property <string> label-group-by: "Group by";
    in property <string> label-chart-style: "Chart style";
    in property <string> status-done: "Done";
    in property <string> status-attention: "Needs attention";
    in property <string> trophy-unlocked-a11y: ", unlocked: ";
    in property <string> trophy-locked-a11y: ", locked: ";
    in property <string> trophy-unlocked-tip: " · unlocked";
    in property <string> trophy-locked-tip: " · locked";
    in property <[string]> compare-periods: ["First", "Second"];
    in property <string> compare-to: "to";
    in property <string> compare-from-suffix: " period from";
    in property <string> compare-to-suffix: " period to";
    in property <string> tip-move-earlier: "Move earlier";
    in property <string> tip-move-later: "Move later";
    in property <string> tip-make-narrow: "Make narrow";
    in property <string> tip-make-wide: "Make wide";
    in property <string> tip-remove-widget: "Remove from the dashboard";

    // Matches, Openings & Teammates pages
    in property <string> sort-by-prefix: "Sort by ";
    in property <string> matches-search-placeholder: "Search mode, date, tag or note";
    in property <string> label-game-mode: "Game mode";
    in property <string> label-chest-type: "Chest type";
    in property <string> label-min-chests: "Minimum chests";
    in property <string> any-count: "Any count";
    in property <string> at-least-prefix: "At least ";
    in property <string> chip-favorites: "★ Favourites";
    in property <string> matches-empty: "No matches yet. Turn on Record Replays in Fortnite, finish a match, and it appears here.";
    in property <[string]> match-headers: ["Date", "Mode", "Place", "Chests", "Broken", "Teammates", "Ammo", "Length"];
