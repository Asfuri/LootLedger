    in property <string> openings-during-match: "Openings during the match";
    in property <string> squad-breakdown-title: "Squad: what each player opened or broke";
    in property <string> label-squad: "Squad";
    in property <[string]> squad-headers: ["Player", "Chests", "Searched", "Broken open", "Share of squad", "Types"];
    in property <string> openings-search-placeholder: "Search type or details";
    in property <string> label-match: "Match";
    in property <string> label-status: "Status";
    in property <[string]> entry-statuses: ["Counted", "Removed", "All statuses"];
    in property <string> openings-empty: "No openings yet. Play a match with Record Replays on.";
    in property <[string]> opening-headers: ["When", "Type", "How", "Count", "Status", "Details"];
    in property <string> btn-remove-entry: "Remove entry";
    in property <string> btn-restore-entry: "Restore entry";
    in property <string> btn-correct-entry: "Correct entry…";
    in property <string> any-matches: "Any number of matches";
    in property <string> matches-suffix: " matches";
    in property <string> label-min-matches: "Minimum matches together";
    in property <string> tip-export-csv: "Export as CSV";
    in property <string> tip-export-json: "Export as JSON";
    in property <[string]> team-records-titles: ["Most chests", "Best single match", "Played most with"];
    in property <[string]> team-headers: ["Player", "Matches", "Chests", "Per match", "Searched", "Broken", "Rare+", "Best"];
    in property <string> label-chest-types: "Chest types";
    in property <string> label-chests-per-match: "Chests per match";
    in property <string> chart-together-empty: "Matches together will chart here";
    in property <string> label-matches-together: "Matches together";
    in property <[string]> profile-match-headers: ["When", "Mode", "Their chests", "Your chests"];
    in property <string> correct-title: "Correct opening";
    in property <string> label-count: "Count";
    in property <string> btn-cancel: "Cancel";
    in property <string> btn-save: "Save";

    // Settings
    in property <string> set-appearance: "Appearance";
    in property <string> set-language: "Language";
    in property <string> set-language-hint: "Switch language immediately without restarting.";
    in property <string> set-theme: "Theme";
    in property <[string]> set-theme-opts: ["Light", "Dark", "System"];
    in property <string> set-theme-label: "Colour theme";
    in property <string> set-accent: "Accent colour";
    in property <string> set-accent-hint: "Presets or your own #rrggbb. Everything is tuned from it.";
    in property <string> set-accent-suffix: " accent colour";
    in property <string> set-accent-custom-label: "Custom accent colour";
    in property <string> set-contrast: "Higher contrast";
    in property <string> set-contrast-hint: "Stronger outlines and muted text.";
    in property <string> set-corners: "Corners";
    in property <[string]> set-corners-opts: ["Sharp", "Default", "Round"];
    in property <string> set-corners-label: "Corner radius";
    in property <string> set-density: "Density";
    in property <[string]> set-density-opts: ["Compact", "Comfortable"];
    in property <string> set-density-label: "Spacing";
    in property <string> set-text-size: "Text size";
    in property <string> set-colorblind: "Colourblind-safe chest colours";
    in property <string> set-colorblind-hint: "Chest types keep one colour everywhere. This swaps in a palette that stays apart for most colour vision.";
    in property <string> set-background: "Background";
    in property <string> set-background-hint: "A soft tonal wash instead of a flat colour.";
    in property <[string]> set-background-opts: ["Solid", "Tonal"];
    in property <string> set-animations: "Animations";
    in property <string> set-animations-hint: "Reduced keeps short fades only. Windows' 'Show animations' off means Reduced.";
    in property <[string]> set-animations-opts: ["Full", "Reduced", "Off"];
    in property <string> set-show-title: "Show page title in title bar";
    in property <string> set-show-title-hint: "Off by default: the page title is already at the top of each page.";

    in property <string> set-tiles-section: "Overview tiles";
    in property <string> set-tiles-row: "Summary tiles";
    in property <string> set-tiles-hint: "Choose which stats appear on Overview. Use Customize there to move and resize them.";

    in property <string> set-formats: "Formats";
    in property <string> set-24h: "24-hour clock";
    in property <string> set-date-format: "Date format";
    in property <string> set-separators: "Number separator";
    in property <string> set-separators-label: "Thousands separator";
    in property <string> set-playtime: "Playtime shown as";
    in property <string> set-default-range: "Default date range";
    in property <string> set-default-range-hint: "Used for the trend chart and the Matches filter.";
    in property <[string]> set-default-range-opts: ["7 days", "30 days", "90 days", "All time"];

    in property <string> set-replays: "Replays";
    in property <string> set-replay-folder: "Replay folder";
    in property <string> set-replay-folder-hint: "Fortnite's default is Saved\\Demos under FortniteGame.";
    in property <string> tip-choose-replay-folder: "Choose the replay folder";
    in property <string> tip-open-replay-folder: "Open the replay folder";
    in property <string> set-auto-watch: "Watch for new replays";
    in property <string> set-auto-watch-hint: "Finished matches are added on their own.";
    in property <string> set-auto-watch-label: "Check for replays automatically";
    in property <string> set-check-every: "Check every";
    in property <string> set-check-every-suffix: " s";
    in property <string> set-check-every-label: "Replay check interval";
    in property <string> set-count-broken: "Count broken-open chests";
    in property <string> set-count-broken-hint: "Chests destroyed by your damage before anyone searched them. Their loot still spills.";
    in property <string> set-count-broken-label: "Count chests you broke open";
    in property <string> set-rescan: "Read every replay again";
    in property <string> set-rescan-hint: "Re-reads all replays Fortnite still keeps. Your corrections are kept.";
    in property <string> set-rescan-btn: "Read all replays again";

    in property <string> set-live-section: "Live match and counter";
    in property <string> set-live-privacy: "LootLedger only reads files Fortnite writes on this PC: the replay and the game's log time. It never touches the Fortnite process: no injection, hooks, memory reading or drawing over the game. The counter is an ordinary LootLedger window that stays on top.";
    in property <string> set-live-track: "Track the current match";
    in property <string> set-live-track-hint: "Fortnite encrypts the replay until the match ends, so the chest count arrives then, seconds after the match. During the match you see that it is live and how long it has run.";
    in property <string> set-live-every-hint: "Fortnite saves the replay about every 20 s. Each check reads one file header.";
    in property <string> set-live-every-label: "Live check interval";
    in property <string> set-overlay: "Pop-out counter";
    in property <string> set-overlay-hint: "A small always-on-top window with the count. Drag and resize it; it remembers where it was.";
    in property <string> set-overlay-opacity: "Counter opacity";
    in property <string> set-overlay-size: "Counter size";
    in property <string> set-overlay-corner: "Counter position";
    in property <[string]> set-overlay-corner-opts: ["Where I put it", "Top left", "Top right", "Bottom left", "Bottom right"];
    in property <string> set-overlay-click: "Click through the counter";
    in property <string> set-overlay-click-hint: "Clicks pass to the window underneath. Turn this off here to move the counter again.";
    in property <string> set-overlay-teammates: "Teammates in the counter";
    in property <string> set-match-popup: "Pop-up after each match";
    in property <string> set-match-popup-hint: "Your chests, placement and how it compares, in the corner for a few seconds. It never takes focus from the game.";
    in property <string> set-sound: "Sound when a match is counted";
    in property <string> set-volume: "Volume";
    in property <string> set-volume-label: "Sound volume";

    in property <string> set-discord-section: "Discord Rich Presence";
    in property <string> set-discord-rpc: "Show status on Discord";
    in property <string> set-discord-rpc-hint: "Displays your last match, today, squad total and Token chance on your Discord profile.";
    in property <string> set-discord-app-id: "Discord Application ID";
    in property <string> set-discord-app-id-hint: "Create an app at discord.com/developers/applications (its name is what appears after Playing) and paste its Application ID here.";
    in property <string> set-discord-app-id-placeholder: "e.g. 1234567890123456789";
    in property <string> set-discord-only-game: "Only while Fortnite is running";
    in property <string> set-discord-only-game-hint: "Turn off to show your stats on Discord whenever LootLedger is open.";

    in property <string> set-goals-section: "Goals";
    in property <string> set-goal-daily: "Daily goal";
    in property <string> set-goal-daily-hint: "Chests per day. Type a number or pick a preset.";
    in property <string> set-goal-weekly: "Weekly goal";
    in property <string> set-goal-weekly-hint: "Chests per week, Monday to Sunday.";
    in property <string> set-no-goal: "No goal";
    in property <[string]> set-daily-presets: ["No goal", "10", "25", "50", "100", "Custom…"];
    in property <[string]> set-weekly-presets: ["No goal", "50", "100", "250", "500", "Custom…"];
    in property <string> set-celebrate: "Celebrate goals and trophies";
    in property <string> set-celebrate-hint: "A short message inside LootLedger. Nothing is sent anywhere.";

    in property <string> set-th-section: "Treasure Hours (Token boost)";
    in property <string> set-th-auto: "Auto-sync official Treasure Hours";
    in property <string> set-th-sync-now: "Sync now";
    in property <string> set-th-add-title: "Add custom Treasure Hour";
    in property <string> set-th-add-hint: "Local date, start–end time (e.g. 16:00 to 20:00) and boost multiplier (e.g. 1.5, 2x, or +50%). Custom entries override auto-synced odds for that window.";
    in property <string> set-th-date-placeholder: "dd/mm/yyyy";
    in property <string> set-th-date-label: "Date";
    in property <string> set-th-start-label: "Start time";
    in property <string> set-th-end-label: "End time";
    in property <string> set-th-boost-label: "Boost";
    in property <string> set-th-add-btn: "Add";
    in property <string> set-th-remove-tip: "Remove custom Treasure Hour";

    in property <string> set-shortcuts-section: "Shortcuts";
    in property <string> set-hk-add: "Add one chest";
    in property <string> set-hk-add-hint: "Works in any app. Example: Ctrl+Alt+F8";
    in property <string> set-hk-add-label: "Manual +1 shortcut";
    in property <string> set-hk-undo: "Undo last chest";
    in property <string> set-hk-undo-hint: "Example: Ctrl+Alt+F9";
    in property <string> set-hk-undo-label: "Undo shortcut";
    in property <string> set-hk-overlay: "Show or hide the counter";
    in property <string> set-hk-overlay-hint: "Example: Ctrl+Alt+F10. Leave empty to turn a shortcut off. Press ? in LootLedger for all shortcuts.";
    in property <string> set-hk-overlay-label: "Show or hide the counter shortcut";

    in property <string> set-data-section: "Data";
    in property <string> set-data-row: "Ledger and settings";
    in property <string> set-data-hint-prefix: "Stored in ";
    in property <string> set-data-hint-suffix: ". Backups hold matches, openings and your edit history.";
    in property <[MenuOption]> data-col1: [
        { id: "Export ledger", label: "Export ledger" },
        { id: "Create backup", label: "Create backup" },
    ];
    in property <[MenuOption]> data-col2: [
        { id: "Restore backup", label: "Restore backup" },
        { id: "Open data folder", label: "Open data folder" },
    ];
    in property <string> sessions-empty: "No sessions yet. A session is a run of matches less than 30 minutes apart. Play a few matches and it appears here.";
    in property <[string]> session-records-titles: ["Average session", "Longest session", "Most chests in a session"];
    in property <string> label-sessions: "Sessions";
    in property <[string]> session-headers: ["Started", "Length", "Matches", "Chests", "Per match", "Per hour", "Best match", "Best place"];
    in property <string> tip-close-session: "Close session details";
    in property <string> session-chart-empty: "Matches will chart here";
