    in property <string> session-matches-label: "Matches in this session";
    in property <[string]> session-match-headers: ["When", "Mode", "Place", "Chests", "Length"];
    in property <[MenuOption]> data-col3: [
        { id: "Export settings", label: "Export settings" },
        { id: "Import settings", label: "Import settings" },
    ];
    in property <[MenuOption]> data-col4: [
        { id: "Export rewards", label: "Export rewards" },
    ];
    in property <string> set-check-updates: "Check for updates";
    in property <string> set-clear-data: "Clear all data…";
    in property <string> set-clear-data-note: "Clearing saves a backup first. Replay files stay on your PC and are not read again until you choose Read all replays again.";

    in property <string> set-about-section: "About";
    in property <string> set-about-prefix: "LootLedger ";
    in property <string> set-about-suffix: " · counts the chests you open in Fortnite from the replays on this PC. Your data never leaves this PC.";
    in property <string> set-auto-update: "Update automatically";
    in property <string> set-auto-update-hint: "Asks GitHub for a newer LootLedger and installs it when you close the app. Only the version check and the download go over the internet; none of your data is sent.";
    in property <string> set-whats-new: "What's new";
