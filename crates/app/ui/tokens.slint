// Material 3 design tokens. Every colour, size, radius and duration comes from here; Rust fills them from
// the user's settings (seed colour, theme, contrast, corners, density, text size, motion).

export global Tokens {
    in property <bool> dark: true;
    // Colour roles
    in property <color> primary: #f4bc5c;
    in property <color> on-primary: #3f2a00;
    in property <color> primary-container: #5e4000;
    in property <color> on-primary-container: #ffdeac;
    in property <color> secondary: #dcc3a1;
    in property <color> secondary-container: #554431;
    in property <color> on-secondary-container: #f9dfbb;
    in property <color> tertiary: #b5cf8c;
    in property <color> tertiary-container: #3a4d1a;
    in property <color> on-tertiary-container: #d1eba6;
    in property <color> error: #ffb4ab;
    in property <color> on-error: #690005;
    in property <color> error-container: #93000a;
    in property <color> on-error-container: #ffdad6;
    in property <color> surface: #161310;
    in property <color> on-surface: #eae1d9;
    in property <color> on-surface-variant: #cec5b8;
    in property <color> outline: #979084;
    in property <color> outline-variant: #4d463c;
    in property <color> container-lowest: #110e0b;
    in property <color> container-low: #1f1b16;
    in property <color> container: #231f1a;
    in property <color> container-high: #2e2924;
    in property <color> container-highest: #39342e;
    in property <color> inverse-surface: #eae1d9;
    in property <color> inverse-on-surface: #34302a;
    in property <[color]> chart: [#e9a23b, #7fbeff, #cf9cff, #6fcf8f, #ff8fc0, #9a9a9a];
    in property <bool> tonal: false;
    out property <color> close-hover: #c42b1c;
    out property <color> on-close: #ffffff;
    out property <color> shadow: #00000066;
    out property <brush> background: tonal ? @linear-gradient(135deg, surface 0%, surface.mix(primary-container, 0.65) 100%) : surface;

    // Type scale (scaled by the text-size setting)
    in property <length> display: 44px;
    in property <length> headline: 24px;
    in property <length> title: 16px;
    in property <length> body: 14px;
    in property <length> label: 12px;
    in property <length> icon: 24px;
    // Spacing (scaled by density)
    in property <length> xxs: 2px;
    in property <length> xs: 4px;
    in property <length> s: 8px;
    in property <length> m: 12px;
    in property <length> l: 16px;
    in property <length> xl: 24px;
    in property <length> button-height: 40px;
    // Shape (scaled by the corner setting); pills use half the height unless corners are sharp
    in property <length> r-xs: 4px;
    in property <length> r-sm: 8px;
    in property <length> r-md: 12px;
    in property <length> r-lg: 16px;
    in property <length> r-xl: 28px;
    in property <length> r-card: 20px;
    in property <bool> sharp: false;
    // Motion: off, reduced (short fades) or full
    in property <bool> motion: true;
    in property <bool> full-motion: true;
    out property <duration> short: motion ? 120ms : 0ms;
    out property <duration> medium: motion ? (full-motion ? 280ms : 150ms) : 0ms;
    out property <duration> long: full-motion ? 600ms : 0ms;

    pure public function pill(height: length) -> length {
        return sharp ? r-sm : height / 2;
    }
    // A state layer over a surface: hover 8%, pressed 12%
    pure public function layer(base: color, over: color, amount: float) -> color {
        return base.mix(over, 1 - amount);
    }
}

// The window-wide tooltip: anything can show one by setting these while hovered or focused.
export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> above;
}

// Dashboard drag state, shared by all cards while one is being dragged.
export global Drag {
    in-out property <int> from: -1;
    in-out property <int> target: -1;
    in-out property <length> x;
    in-out property <length> y;
}
