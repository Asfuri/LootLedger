// Settings: every option from LootLedger 0.7.1. Values come from Rust; changes go back through Settings.set.
import { Tokens } from "tokens.slint";
import { Icons } from "icons.slint";
import { Icon, IconButton, Button, Chip, Switch, Segmented, TextField, Slider, Stepper, Card } from "controls.slint";
import { I18n, MenuOption } from "i18n.slint";

export struct TreasureHourItem {
    id: string,
    when: string,
    boost: string,
    source: string,
    custom: bool,
    active: bool,
}

export global Settings {
    in property <int> language;
    in property <[string]> language-names: ["English", "Português (Brasil)"];
    in property <int> theme;          // light, dark, system
    in property <string> seed;
    in property <[color]> seeds;
    in property <[string]> seed-names;
    in property <int> seed-index: -1;
    in property <bool> contrast;
    in property <int> corners;        // sharp, default, round
    in property <int> density;        // compact, comfortable
    in property <int> font-scale;     // S M L XL
    in property <bool> colorblind;
    in property <int> chart-style;    // bar line smooth area
    in property <int> background;     // solid tonal
    in property <int> motion;         // full reduced off
    in property <bool> show-page-title;
    in property <[string]> tile-names;
    in property <[bool]> tiles-on;
    in property <bool> time-24h;
    in property <int> date-format;
    in property <int> separators;
    in property <int> playtime;
    in property <int> default-range;
    in property <string> folder;
    in property <bool> auto-watch;
    in property <int> scan-seconds: 30;
    in property <bool> count-broken;
    in property <bool> live-tracking;
    in property <int> live-seconds;   // index of 1, 2, 5, 10 s
    in property <bool> overlay;
    in property <int> overlay-opacity;
    in property <int> overlay-size;
    in property <int> overlay-corner;
    in property <bool> overlay-click-through;
    in property <bool> overlay-teammates;
    in property <bool> sound;
    in property <bool> match-popup;
    in property <int> volume;
    in property <int> goal-daily;
    in property <int> goal-weekly;
    in property <bool> celebrate;
    in property <bool> auto-treasure-hours;
    in property <string> treasure-status;
    in-out property <string> th-date;
    in-out property <string> th-start;
    in-out property <string> th-end;
    in-out property <string> th-boost;
    in property <[TreasureHourItem]> treasure-hours;
    in property <string> hotkey-add;
    in property <string> hotkey-undo;
    in property <string> hotkey-overlay;
    in property <string> data-folder;
    in property <string> version;
    in property <bool> auto-update;
    in property <bool> discord-rpc;
    in-out property <string> discord-app-id;
    in property <bool> discord-only-in-game;
    in property <string> discord-status;
    callback set(string, string);
    callback action(string);
    callback add-treasure-hour(string, string, string, string);
    callback remove-treasure-hour(string);
}

component Row inherits HorizontalLayout {
    in property <string> name;
    in property <string> hint;
    spacing: Tokens.l;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: Tokens.xxs;
        Text { text: name; font-size: Tokens.body; color: Tokens.on-surface; wrap: word-wrap; }
        if hint != "": Text { text: hint; font-size: Tokens.body; color: Tokens.on-surface-variant; wrap: word-wrap; }
    }
    HorizontalLayout {
        alignment: end;
        @children
    }
}

component Section inherits Card {
    VerticalLayout {
        spacing: Tokens.m;
        @children
    }
}

export component SettingsPage inherits VerticalLayout {
    spacing: Tokens.m;
    Section {
        title: I18n.set-appearance;
        icon: Icons.palette;
        Row {
            name: I18n.set-language;
            hint: I18n.set-language-hint;
            Segmented { options: Settings.language-names; current: Settings.language; label: I18n.set-language; changed(i) => { Settings.set("language", i); } }
        }
        Row {
            name: I18n.set-theme;
            Segmented { options: I18n.set-theme-opts; current: Settings.theme; label: I18n.set-theme-label; changed(i) => { Settings.set("theme", i); } }
        }
        Row {
            name: I18n.set-accent;
            hint: I18n.set-accent-hint;
            HorizontalLayout {
                spacing: Tokens.s;
                for c[i] in Settings.seeds: Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - 28px) / 2;
                    border-radius: Tokens.pill(28px);
                    border-width: 3px;
                    border-color: i == Settings.seed-index ? Tokens.on-surface : Tokens.container-high;
                    background: c;
                    accessible-role: button;
                    accessible-label: Settings.seed-names[i] + I18n.set-accent-suffix;
                    accessible-action-default => { Settings.set("seed-index", i); }
                    TouchArea { mouse-cursor: pointer; clicked => { Settings.set("seed-index", i); } }
                }
                TextField {
                    width: 120px;
                    text: Settings.seed;
                    placeholder: "#rrggbb";
                    label: I18n.set-accent-custom-label;
                    accepted(text) => { Settings.set("seed", text); }
                }
            }
        }
        Row {
            name: I18n.set-contrast;
            hint: I18n.set-contrast-hint;
            Switch { checked: Settings.contrast; label: I18n.set-contrast; toggled(on) => { Settings.set("contrast", on ? "true" : "false"); } }
        }
        Row {
            name: I18n.set-corners;
            Segmented { options: I18n.set-corners-opts; current: Settings.corners; label: I18n.set-corners-label; changed(i) => { Settings.set("corners", i); } }
        }
        Row {
            name: I18n.set-density;
            Segmented { options: I18n.set-density-opts; current: Settings.density; label: I18n.set-density-label; changed(i) => { Settings.set("density", i); } }
        }
        Row {
            name: I18n.set-text-size;
            Segmented { options: ["S", "M", "L", "XL"]; current: Settings.font-scale; label: I18n.set-text-size; changed(i) => { Settings.set("font_scale", i); } }
        }
        Row {
            name: I18n.set-colorblind;
            hint: I18n.set-colorblind-hint;
            Switch { checked: Settings.colorblind; label: I18n.set-colorblind; toggled(on) => { Settings.set("colorblind", on ? "true" : "false"); } }
        }
        Row {
            name: I18n.label-chart-style;
            Segmented { options: I18n.chart-styles; current: Settings.chart-style; label: I18n.label-chart-style; changed(i) => { Settings.set("chart_style", i); } }
        }
        Row {
            name: I18n.set-background;
            hint: I18n.set-background-hint;
            Segmented { options: I18n.set-background-opts; current: Settings.background; label: I18n.set-background; changed(i) => { Settings.set("background", i); } }
        }
        Row {
            name: I18n.set-animations;
            hint: I18n.set-animations-hint;
            Segmented { options: I18n.set-animations-opts; current: Settings.motion; label: I18n.set-animations; changed(i) => { Settings.set("motion", i); } }
        }
        Row {
            name: I18n.set-show-title;
            hint: I18n.set-show-title-hint;
            Switch { checked: Settings.show-page-title; label: I18n.set-show-title; toggled(on) => { Settings.set("show_page_title", on ? "true" : "false"); } }
        }
    }
    Section {
        title: I18n.set-tiles-section;
        icon: Icons.dashboard-customize;
        Row {
            name: I18n.set-tiles-row;
            hint: I18n.set-tiles-hint;
            Rectangle {
                width: 3 * 150px + 2 * Tokens.s;
                height: ceil(Settings.tile-names.length / 3) * (32px + Tokens.s);
                for name[i] in Settings.tile-names: Chip {
                    x: mod(i, 3) * (150px + Tokens.s);
                    y: floor(i / 3) * (32px + Tokens.s);
                    width: 150px;
                    text: name;
                    checked: Settings.tiles-on[i];
                    toggled(on) => { Settings.set("tile:" + i, on ? "true" : "false"); }
                }
            }
        }
    }
    Section {
        title: I18n.set-formats;
        icon: Icons.schedule;
        Row {
            name: I18n.set-24h;
            Switch { checked: Settings.time-24h; label: I18n.set-24h; toggled(on) => { Settings.set("time_24h", on ? "true" : "false"); } }
        }
        Row {
            name: I18n.set-date-format;
            Segmented { options: ["dd/mm/yyyy", "mm/dd/yyyy", "yyyy-mm-dd"]; current: Settings.date-format; label: I18n.set-date-format; changed(i) => { Settings.set("date_format", i); } }
        }
        Row {
            name: I18n.set-separators;
            Segmented { options: ["1,234", "1.234", "1 234", "1234"]; current: Settings.separators; label: I18n.set-separators-label; changed(i) => { Settings.set("separators", i); } }
        }
        Row {
            name: I18n.set-playtime;
            Segmented { options: ["12h 40m", "12.7 h"]; current: Settings.playtime; label: I18n.set-playtime; changed(i) => { Settings.set("playtime", i); } }
        }
        Row {
            name: I18n.set-default-range;
            hint: I18n.set-default-range-hint;
            Segmented { options: I18n.set-default-range-opts; current: Settings.default-range; label: I18n.set-default-range; changed(i) => { Settings.set("default_range", i); } }
        }
    }
    Section {
        title: I18n.set-replays;
        icon: Icons.folder-open;
        Row {
            name: I18n.set-replay-folder;
            hint: I18n.set-replay-folder-hint;
            HorizontalLayout {
                spacing: Tokens.s;
                TextField { width: 300px; text: Settings.folder; label: I18n.set-replay-folder; accepted(text) => { Settings.set("replay_folder", text); } }
                IconButton { icon: Icons.folder; tip: I18n.tip-choose-replay-folder; clicked => { Settings.action("browse-folder"); } }
                IconButton { icon: Icons.open-in-new; tip: I18n.tip-open-replay-folder; clicked => { Settings.action("open-replays"); } }
            }
        }
        Row {
            name: I18n.set-auto-watch;
            hint: I18n.set-auto-watch-hint;
            Switch { checked: Settings.auto-watch; label: I18n.set-auto-watch-label; toggled(on) => { Settings.set("auto_watch", on ? "true" : "false"); } }
        }
        Row {
            name: I18n.set-check-every;
            Stepper { value: Settings.scan-seconds; minimum: 5; maximum: 600; step: 5; suffix: I18n.set-check-every-suffix; label: I18n.set-check-every-label; changed(v) => { Settings.set("scan_seconds", v); } }
        }
        Row {
            name: I18n.set-count-broken;
            hint: I18n.set-count-broken-hint;
            Switch { checked: Settings.count-broken; label: I18n.set-count-broken-label; toggled(on) => { Settings.set("count_broken", on ? "true" : "false"); } }
        }
        Row {
            name: I18n.set-rescan;
            hint: I18n.set-rescan-hint;
            Button { text: I18n.set-rescan-btn; clicked => { Settings.action("rescan"); } }
        }
    }
    Section {
        title: I18n.set-live-section;
        icon: Icons.sensors;
        Text {
            text: I18n.set-live-privacy;
            font-size: Tokens.body;
            color: Tokens.on-surface-variant;
            wrap: word-wrap;
        }
        Row {
            name: I18n.set-live-track;
            hint: I18n.set-live-track-hint;
            Switch { checked: Settings.live-tracking; label: I18n.set-live-track; toggled(on) => { Settings.set("live_tracking", on ? "true" : "false"); } }
        }
        Row {
            name: I18n.set-check-every;
            hint: I18n.set-live-every-hint;
            Segmented { options: ["1 s", "2 s", "5 s", "10 s"]; current: Settings.live-seconds; label: I18n.set-live-every-label; changed(i) => { Settings.set("live_seconds", i); } }
        }
        Row {
            name: I18n.set-overlay;
            hint: I18n.set-overlay-hint;
            Switch { checked: Settings.overlay; label: I18n.set-overlay; toggled(on) => { Settings.set("overlay", on ? "true" : "false"); } }
        }
        Row {
            name: I18n.set-overlay-opacity;
            Slider { value: Settings.overlay-opacity; minimum: 30; maximum: 100; label: I18n.set-overlay-opacity; changed(v) => { Settings.set("overlay_opacity", v); } }
        }
        Row {
            name: I18n.set-overlay-size;
            Segmented { options: ["S", "M", "L"]; current: Settings.overlay-size; label: I18n.set-overlay-size; changed(i) => { Settings.set("overlay_size", i); } }
        }
        Row {
            name: I18n.set-overlay-corner;
            Segmented {
                options: I18n.set-overlay-corner-opts;
                current: Settings.overlay-corner;
                label: I18n.set-overlay-corner;
                changed(i) => { Settings.set("overlay_corner", i); }
            }
        }
        Row {
            name: I18n.set-overlay-click;
            hint: I18n.set-overlay-click-hint;
            Switch { checked: Settings.overlay-click-through; label: I18n.set-overlay-click; toggled(on) => { Settings.set("overlay_click_through", on ? "true" : "false"); } }
        }
        Row {
            name: I18n.set-overlay-teammates;
            Switch { checked: Settings.overlay-teammates; label: I18n.set-overlay-teammates; toggled(on) => { Settings.set("overlay_teammates", on ? "true" : "false"); } }
        }
        Row {
            name: I18n.set-match-popup;
            hint: I18n.set-match-popup-hint;
            Switch { checked: Settings.match-popup; label: I18n.set-match-popup; toggled(on) => { Settings.set("match_popup", on ? "true" : "false"); } }
        }
        Row {
            name: I18n.set-sound;
            Switch { checked: Settings.sound; label: I18n.set-sound; toggled(on) => { Settings.set("sound", on ? "true" : "false"); } }
        }
        Row {
            name: I18n.set-volume;
            Slider { value: Settings.volume; minimum: 0; maximum: 100; label: I18n.set-volume-label; changed(v) => { Settings.set("volume", v); } }
        }
    }
    Section {
        title: I18n.set-discord-section;
        icon: Icons.sports-esports;
        Row {
            name: I18n.set-discord-rpc;
            hint: Settings.discord-status != "" ? Settings.discord-status : I18n.set-discord-rpc-hint;
            Switch { checked: Settings.discord-rpc; label: I18n.set-discord-rpc; toggled(on) => { Settings.set("discord_rpc", on ? "true" : "false"); } }
        }
        Row {
            name: I18n.set-discord-app-id;
            hint: I18n.set-discord-app-id-hint;
            TextField {
                width: 240px;
                text <=> Settings.discord-app-id;
                placeholder: I18n.set-discord-app-id-placeholder;
                label: I18n.set-discord-app-id;
                accepted(text) => { Settings.set("discord_app_id", text); }
            }
        }
        Row {
            name: I18n.set-discord-only-game;
            hint: I18n.set-discord-only-game-hint;
            Switch { checked: Settings.discord-only-in-game; label: I18n.set-discord-only-game; toggled(on) => { Settings.set("discord_only_in_game", on ? "true" : "false"); } }
        }
    }
    Section {
        title: I18n.set-goals-section;
        icon: Icons.flag;
        Row {
            name: I18n.set-goal-daily;
            hint: I18n.set-goal-daily-hint;
            Stepper {
                width: 220px;
                value: Settings.goal-daily;
                maximum: 10000;
                step: 5;
                special: I18n.set-no-goal;
                label: I18n.set-goal-daily;
                preset-names: I18n.set-daily-presets;
                preset-values: [0, 10, 25, 50, 100, -1];
                changed(v) => { Settings.set("goal_daily", v); }
            }
        }
        Row {
            name: I18n.set-goal-weekly;
            hint: I18n.set-goal-weekly-hint;
            Stepper {
                width: 220px;
                value: Settings.goal-weekly;
                maximum: 100000;
                step: 5;
                special: I18n.set-no-goal;
                label: I18n.set-goal-weekly;
                preset-names: I18n.set-weekly-presets;
                preset-values: [0, 50, 100, 250, 500, -1];
                changed(v) => { Settings.set("goal_weekly", v); }
            }
        }
        Row {
            name: I18n.set-celebrate;
            hint: I18n.set-celebrate-hint;
            Switch { checked: Settings.celebrate; label: I18n.set-celebrate; toggled(on) => { Settings.set("celebrate", on ? "true" : "false"); } }
        }
    }
    Section {
        title: I18n.set-th-section;
        icon: Icons.bolt;
        Row {
            name: I18n.set-th-auto;
            hint: Settings.treasure-status;
            HorizontalLayout {
                spacing: Tokens.s;
                Button { text: I18n.set-th-sync-now; icon: Icons.sync; clicked => { Settings.action("sync-treasure-hours"); } }
                Switch { checked: Settings.auto-treasure-hours; label: I18n.set-th-auto; toggled(on) => { Settings.set("auto_treasure_hours", on ? "true" : "false"); } }
            }
        }
        VerticalLayout {
            spacing: Tokens.xs;
            Text { text: I18n.set-th-add-title; font-size: Tokens.body; color: Tokens.on-surface; wrap: word-wrap; }
            Text {
                text: I18n.set-th-add-hint;
                font-size: Tokens.body;
                color: Tokens.on-surface-variant;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Tokens.s;
                alignment: start;
                TextField { width: 130px; text <=> Settings.th-date; placeholder: I18n.set-th-date-placeholder; label: I18n.set-th-date-label; }
                TextField { width: 120px; text <=> Settings.th-start; placeholder: "16:00"; label: I18n.set-th-start-label; }
                TextField { width: 120px; text <=> Settings.th-end; placeholder: "20:00"; label: I18n.set-th-end-label; }
                TextField { width: 120px; text <=> Settings.th-boost; placeholder: "1.5x"; label: I18n.set-th-boost-label; }
                Button {
                    text: I18n.set-th-add-btn;
                    icon: Icons.add;
                    kind: "filled";
                    clicked => { Settings.add-treasure-hour(Settings.th-date, Settings.th-start, Settings.th-end, Settings.th-boost); }
                }
            }
        }
        if Settings.treasure-hours.length > 0: VerticalLayout {
            spacing: Tokens.xs;
            for item in Settings.treasure-hours: Rectangle {
                height: 36px;
                border-radius: Tokens.sharp ? Tokens.r-xs : Tokens.r-sm;
                background: item.active ? Tokens.primary-container : Tokens.container-highest;
                HorizontalLayout {
                    padding-left: Tokens.m;
                    padding-right: Tokens.s;
                    spacing: Tokens.m;
                    Text {
                        text: item.when;
                        font-size: Tokens.body;
                        font-weight: item.active ? 700 : 500;
                        color: item.active ? Tokens.on-primary-container : Tokens.on-surface;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: item.boost;
                        font-size: Tokens.body;
                        font-weight: 600;
                        color: item.active ? Tokens.on-primary-container : Tokens.primary;
                        vertical-alignment: center;
                    }
                    Text {
                        text: item.source;
                        font-size: Tokens.body;
                        color: item.active ? Tokens.on-primary-container : Tokens.on-surface-variant;
                        vertical-alignment: center;
                    }
                    if item.custom: IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.delete;
                        tip: I18n.set-th-remove-tip;
                        size: 28px;
                        clicked => { Settings.remove-treasure-hour(item.id); }
                    }
                }
            }
        }
    }
    Section {
        title: I18n.set-shortcuts-section;
        icon: Icons.keyboard;
        Row {
            name: I18n.set-hk-add;
            hint: I18n.set-hk-add-hint;
            TextField { width: 200px; text: Settings.hotkey-add; label: I18n.set-hk-add-label; accepted(text) => { Settings.set("hotkey_add", text); } }
        }
        Row {
            name: I18n.set-hk-undo;
            hint: I18n.set-hk-undo-hint;
            TextField { width: 200px; text: Settings.hotkey-undo; label: I18n.set-hk-undo-label; accepted(text) => { Settings.set("hotkey_undo", text); } }
        }
        Row {
            name: I18n.set-hk-overlay;
            hint: I18n.set-hk-overlay-hint;
            TextField { width: 200px; text: Settings.hotkey-overlay; label: I18n.set-hk-overlay-label; accepted(text) => { Settings.set("hotkey_overlay", text); } }
        }
    }
    Section {
        title: I18n.set-data-section;
        icon: Icons.database;
        Row {
            name: I18n.set-data-row;
            hint: I18n.set-data-hint-prefix + Settings.data-folder + I18n.set-data-hint-suffix;
            VerticalLayout {
                spacing: Tokens.s;
                for col in [I18n.data-col1, I18n.data-col2, I18n.data-col3, I18n.data-col4]: HorizontalLayout {
                    spacing: Tokens.s;
                    for item in col: Button { min-width: 180px; text: item.label; clicked => { Settings.action(item.id); } }
                }
                HorizontalLayout {
                    spacing: Tokens.s;
                    Button { min-width: 180px; text: I18n.set-check-updates; clicked => { Settings.action("Check for updates"); } }
                    Button { min-width: 180px; text: I18n.set-clear-data; kind: "danger"; clicked => { Settings.action("Clear all data"); } }
                }
            }
        }
        Text {
            text: I18n.set-clear-data-note;
            font-size: Tokens.body;
            color: Tokens.on-surface-variant;
            wrap: word-wrap;
        }
    }
    Section {
        title: I18n.set-about-section;
        icon: Icons.info;
        Text {
            text: I18n.set-about-prefix + Settings.version + I18n.set-about-suffix;
            font-size: Tokens.body;
            color: Tokens.on-surface;
            wrap: word-wrap;
        }
        Row {
            name: I18n.set-auto-update;
            hint: I18n.set-auto-update-hint;
            Switch { checked: Settings.auto-update; label: I18n.set-auto-update; toggled(on) => { Settings.set("auto_update", on ? "true" : "false"); } }
        }
        HorizontalLayout {
            alignment: start;
            Button { text: I18n.set-whats-new; kind: "text"; clicked => { Settings.action("What's new"); } }
        }
    }
}
