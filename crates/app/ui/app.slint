import { ScrollView, ListView } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
export { Tokens }

export struct LedgerRow { first: string, second: string, third: string, fourth: string }

component Action inherits Rectangle {
    in property <string> text;
    callback clicked;
    min-height: 40px;
    min-width: 112px;
    border-radius: Tokens.pill;
    background: touch.pressed ? Tokens.selected : touch.has-hover ? Tokens.high : Tokens.container;
    animate background { duration: Tokens.duration; }
    Text { text: root.text; color: Tokens.ink; horizontal-alignment: center; vertical-alignment: center; font-size: 14px; }
    touch := TouchArea { clicked => { root.clicked(); } }
    accessible-role: AccessibleRole.button;
    accessible-label: text;
}

export component AppWindow inherits Window {
    title: "LootLedger · migration preview";
    no-frame: true;
    preferred-width: 1240px;
    preferred-height: 860px;
    min-width: 860px;
    min-height: 580px;
    background: Tokens.surface;
    default-font-family: "Segoe UI";
    in-out property <int> page: 0;
    in-out property <bool> show-page-title: false;
    in-out property <bool> is-maximized: false;
    in-out property <bool> max-hover: false;
    in-out property <float> progress: 1;
    in-out property <[float]> values: [0.25, 0.48, 0.38, 0.72, 0.5, 0.95, 0.64, 0.8, 0.5, 0.65, 1, 0.7];
    in-out property <[string]> cards: ["All time", "Today", "This week", "Last match"];
    in property <[string]> counts: ["—", "—", "—", "—"];
    in property <string> summary: "Replay decoding parity is still being implemented.";
    in property <string> live-status: "Watching is not active.";
    in property <[LedgerRow]> rows;
    in property <[string]> headers: ["When", "Mode", "Chests", "Detail"];
    property <[string]> pages: ["Overview", "Matches", "Openings", "Statistics", "Teammates", "Settings & data"];
    callback minimize;
    callback maximize;
    callback request-close;
    callback reorder(int, int);
    callback animate-chart;
    callback navigate(int);
    changed page => { root.navigate(root.page); }
    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 36px;
            HorizontalLayout {
                padding-left: Tokens.xl;
                spacing: 0px;
                Text { text: root.show-page-title ? root.pages[root.page] : ""; color: Tokens.muted; font-size: 12px; vertical-alignment: center; }
                for control[index] in ["Minimize", "Maximize or restore", "Close"] : Rectangle {
                    width: 46px;
                    height: 36px;
                    background: button.has-hover || (index == 1 && root.max-hover) ? (index == 2 ? Tokens.close-hover : Tokens.high) : Tokens.surface;
                    Text {
                        text: index == 0 ? "─" : index == 1 ? (root.is-maximized ? "❐" : "□") : "×";
                        color: index == 2 && button.has-hover ? Tokens.white : Tokens.ink;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    accessible-role: AccessibleRole.button;
                    accessible-label: control;
                    button := TouchArea { clicked => { if index == 0 { root.minimize(); } else if index == 1 { root.maximize(); } else { root.request-close(); } } }
                }
            }
        }
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 164px;
                VerticalLayout {
                    padding: Tokens.md;
                    spacing: Tokens.sm;
                    for name[index] in root.pages : Rectangle {
                        height: 48px;
                        border-radius: Tokens.pill;
                        background: root.page == index ? Tokens.selected : nav.has-hover ? Tokens.container : Tokens.surface;
                        animate background { duration: Tokens.duration; }
                        Text { x: Tokens.lg; text: name; color: root.page == index ? Tokens.accent : Tokens.muted; vertical-alignment: center; font-size: 14px; }
                        accessible-role: AccessibleRole.button;
                        accessible-label: name;
                        nav := TouchArea { clicked => { root.page = index; } }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text { text: "Migration preview\nRead-only ledger"; color: Tokens.muted; font-size: 12px; }
                }
            }
            ScrollView {
                content-width: self.visible-width;
                VerticalLayout {
                    padding: Tokens.xl;
                    spacing: Tokens.lg;
                    Text { text: root.pages[root.page]; color: Tokens.ink; font-size: 28px; }
                    Text { text: root.summary; color: Tokens.muted; font-size: 14px; wrap: word-wrap; }
                    Text { text: root.live-status; color: Tokens.muted; font-size: 13px; wrap: word-wrap; }
                    if root.page == 0 || root.page == 3 : VerticalLayout {
                        spacing: Tokens.lg;
                        HorizontalLayout {
                            spacing: Tokens.md;
                            for card[index] in root.cards : Rectangle {
                                height: 120px;
                                border-radius: Tokens.card;
                                background: card-touch.pressed ? Tokens.high : Tokens.container;
                                VerticalLayout {
                                    padding: Tokens.lg;
                                    Text { text: card; color: Tokens.muted; font-size: 13px; }
                                    Text { text: root.counts[index]; color: Tokens.ink; font-size: 30px; }
                                }
                                card-touch := TouchArea {
                                    pointer-event(event) => { if event.kind == PointerEventKind.up && self.mouse-x - self.pressed-x > self.width / 2 { root.reorder(index, min(index + 1, 3)); } else if event.kind == PointerEventKind.up && self.pressed-x - self.mouse-x > self.width / 2 { root.reorder(index, max(index - 1, 0)); } }
                                }
                            }
                        }
                        Rectangle {
                            height: 340px;
                            border-radius: Tokens.card;
                            background: Tokens.container;
                            VerticalLayout {
                                padding: Tokens.xl;
                                spacing: Tokens.lg;
                                HorizontalLayout {
                                    Text { text: "Chart and motion spike"; color: Tokens.ink; font-size: 18px; vertical-alignment: center; }
                                    Action { text: "Replay motion"; clicked => { root.animate-chart(); } }
                                }
                                HorizontalLayout {
                                    spacing: Tokens.sm;
                                    for value[index] in root.values : Rectangle {
                                        background: transparent;
                                        Rectangle {
                                            y: parent.height * (1 - root.progress * value);
                                            height: parent.height * root.progress * value;
                                            width: parent.width;
                                            border-top-left-radius: Tokens.control;
                                            border-top-right-radius: Tokens.control;
                                            background: Tokens.accent;
                                        }
                                    }
                                }
                                HorizontalLayout { for month in ["Jan", "Mar", "May", "Jul", "Sep", "Nov"] : Text { text: month; color: Tokens.muted; font-size: 12px; } }
                            }
                        }
                    }
                    if root.page == 5 : VerticalLayout {
                        spacing: Tokens.md;
                        HorizontalLayout {
                            spacing: Tokens.md;
                            Action { text: Tokens.dark ? "Light theme" : "Dark theme"; clicked => { Tokens.dark = !Tokens.dark; } }
                            Action { text: "Corner shape"; clicked => { Tokens.corners = mod(Tokens.corners + 1, 3); } }
                            Action { text: Tokens.motion ? "Motion off" : "Motion on"; clicked => { Tokens.motion = !Tokens.motion; } }
                        }
                        Action { text: root.show-page-title ? "Hide title context" : "Show title context"; clicked => { root.show-page-title = !root.show-page-title; } }
                    }
                    if root.page != 0 && root.page != 3 && root.page != 5 : Rectangle {
                        min-height: 440px;
                        border-radius: Tokens.card;
                        background: Tokens.container;
                        clip: true;
                        VerticalLayout {
                            spacing: 0px;
                            Rectangle {
                                height: 48px;
                                border-top-left-radius: Tokens.card;
                                border-top-right-radius: Tokens.card;
                                background: Tokens.high;
                                HorizontalLayout { padding-left: Tokens.lg; padding-right: Tokens.lg; for title in root.headers : Text { text: title; color: Tokens.muted; font-size: 13px; vertical-alignment: center; } }
                            }
                            ListView {
                                for row in root.rows : Rectangle {
                                    height: 48px;
                                    background: row-touch.has-hover ? Tokens.high : Tokens.container;
                                    HorizontalLayout {
                                        padding-left: Tokens.lg;
                                        padding-right: Tokens.lg;
                                        spacing: Tokens.md;
                                        for text in [row.first, row.second, row.third, row.fourth] : Text { text: text; color: Tokens.ink; font-size: 13px; overflow: elide; vertical-alignment: center; }
                                    }
                                    row-touch := TouchArea {}
                                }
                            }
                        }
                    }
                    Rectangle { min-height: Tokens.xl; vertical-stretch: 1; }
                }
            }
        }
    }
}
