diff --git a/src/Unreal.Core/NetFieldParser.cs b/src/Unreal.Core/NetFieldParser.cs
index 20d08d3..7e85108 100644
--- a/src/Unreal.Core/NetFieldParser.cs
+++ b/src/Unreal.Core/NetFieldParser.cs
@@ -243,7 +243,37 @@ public class NetFieldParser
     /// </summary>
     /// <param name="group"></param>
     /// <returns>true if group should be parsed further, false otherwise</returns>
-    public bool WillReadType(string group) => NetFieldGroups.TryGetValue(group, out var _);
+    public bool WillReadType(string group) => ResolveGroup(group);
+
+    /// <summary>
+    /// Optional resolver for export groups that have no registered class. It returns the path of a registered
+    /// group whose class should parse <c>group</c> (for example, a generic container class), or null to skip it.
+    /// </summary>
+    public Func<string, string?>? GroupFallback { get; set; }
+
+    private readonly HashSet<string> _unresolvedGroups = new();
+
+    private bool ResolveGroup(string group)
+    {
+        if (NetFieldGroups.TryGetIndex(group, out _))
+        {
+            return true;
+        }
+
+        if (GroupFallback is null || _unresolvedGroups.Contains(group))
+        {
+            return false;
+        }
+
+        var target = GroupFallback(group);
+        if (target is not null && NetFieldGroups.AddAlias(group, target))
+        {
+            return true;
+        }
+
+        _unresolvedGroups.Add(group);
+        return false;
+    }
 
     /// <summary>
     /// Returns whether or not this <paramref name="group"/> is marked to be parsed.
@@ -284,7 +314,7 @@ public class NetFieldParser
 
         if (exportGroup.GroupId == -1)
         {
-            if (!NetFieldGroups.TryGetIndex(exportGroup.PathName, out var groupIndex))
+            if (!ResolveGroup(exportGroup.PathName) || !NetFieldGroups.TryGetIndex(exportGroup.PathName, out var groupIndex))
             {
                 exportGroup.GroupId = -2;
                 return false;
@@ -577,7 +607,7 @@ public class NetFieldParser
     /// <returns></returns>
     public INetFieldExportGroup? CreateType(string group)
     {
-        if (!NetFieldGroups.TryGetValue(group, out var exportGroup))
+        if (!ResolveGroup(group) || !NetFieldGroups.TryGetValue(group, out var exportGroup))
         {
             return null;
         }
